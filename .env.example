# Public site URL — used for OG tags and canonical links
NEXT_PUBLIC_SITE_URL=https://fusionfashionevents.com

# --- Cloudflare Stream (server-side API access) ---
# Create token at dash.cloudflare.com → My Profile → API Tokens
# Scope: Account → Stream → Edit, restricted to one account
CF_API_TOKEN=
CF_ACCOUNT_ID=

# --- Cloudflare Stream Live Input ---
# UID of the Live Input that OBS pushes to
CF_STREAM_LIVE_INPUT_ID=af6164876a3eeaaa5a564735702650ba

# Customer subdomain for player + HLS playback URLs (safe to expose)
NEXT_PUBLIC_CF_STREAM_CUSTOMER_SUBDOMAIN=customer-pgpql92xumpqnyup.cloudflarestream.com
